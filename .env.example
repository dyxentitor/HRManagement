# === Django ===
DJANGO_SETTINGS_MODULE=hrms_api.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# === Field-level encryption (Fernet key — REQUIRED) ===
# Generate a fresh key for THIS environment. Never reuse the dev key
# in production. Never reuse the production key elsewhere.
#
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Losing this key = unrecoverable PII for every IC, bank account,
# EPF/SOCSO/EIS, and LHDN tax ID encrypted under it.
# Back it up offline (password manager, sealed envelope) before going live.
HRMS_FIELD_ENCRYPTION_KEY=

# === Database ===
DATABASE_URL=postgres://hrms:hrms@postgres:5432/hrms

# === Redis (cache + Celery broker) ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Object storage (S3-compatible: MinIO in dev, S3 in prod) ===
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=hrms
S3_SECRET_KEY=hrms-dev-secret
S3_BUCKET=hrms
S3_REGION=us-east-1
S3_USE_SSL=0

# === Email — DEV uses MailHog, PROD use real SMTP ===
# For Provintell prod, set these to your SMTP provider:
#   SMTP_HOST=smtp.gmail.com (or your provider, e.g. smtp.office365.com)
#   SMTP_PORT=587
#   SMTP_USER=hrms@provintell.com
#   SMTP_PASSWORD=<app-password>   # pragma: allowlist secret
#   SMTP_USE_TLS=1
#   DEFAULT_FROM_EMAIL=hrms@provintell.com
#
# Test from inside the API container after setting the above:
#   docker compose exec api uv run python manage.py sendtestemail admin@provintell.com
#
# DEV defaults (MailHog UI at http://localhost:8025):
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=0
DEFAULT_FROM_EMAIL=hrms@provintell.local

# === Frontend ===
VITE_API_BASE_URL=http://localhost:8000
