# ---- Django ----
DJANGO_SETTINGS_MODULE=hrms_api.settings.prod
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=192.168.1.111,localhost,api
# generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
JWT_SIGNING_KEY=CHANGE_ME
# generate ONCE, keep forever: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
HRMS_FIELD_ENCRYPTION_KEY=CHANGE_ME
CSRF_TRUSTED_ORIGINS=https://192.168.1.111
# ---- Database (fresh prod DB) ----
POSTGRES_USER=hrms_prod
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hrms_prod
DATABASE_URL=postgres://hrms_prod:CHANGE_ME@postgres:5432/hrms_prod
# ---- Frontend / URLs ----
VITE_API_BASE_URL=
FRONTEND_BASE_URL=https://192.168.1.111
# ---- Email (Microsoft 365) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hrms@provintell.com
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=hrms@provintell.com
# ---- Object storage (persistent MinIO behind nginx TLS on :9443) ----
S3_ENDPOINT_URL=http://minio:9000
# Browser-facing endpoint — nginx TLS proxy (Task A4); signatures computed here
S3_PUBLIC_ENDPOINT_URL=https://192.168.1.111:9443
S3_BUCKET=hrms
# S3_ACCESS_KEY/SECRET_KEY MUST equal MINIO_ROOT_USER/PASSWORD below
S3_ACCESS_KEY=hrms_prod
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=hrms_prod
MINIO_ROOT_PASSWORD=CHANGE_ME
# ---- Error tracking (optional) ----
SENTRY_DSN=
